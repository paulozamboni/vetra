DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-random-secret
CPF_ENCRYPTION_KEY=replace-with-a-fernet-key
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
